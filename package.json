{
  "name": "chatgpt2codex",
  "version": "0.2.0",
  "description": "Local MCP coding runtime that lets GPT/ChatGPT act as a Codex-like coding agent over a multi-project workspace.",
  "author": "ezBuilder",
  "copyright": "Copyright 2026 ezBuilder. All rights reserved.",
  "type": "module",
  "bin": {
    "chatgpt2codex": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "audit:moderate": "npm audit --audit-level=moderate",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node dist/runtime/runtime-manifest.js --seal",
    "build:macos-app": "bash scripts/build-macos-app.sh",
    "chatgpt": "bash start-chatgpt.sh",
    "chatgpt:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File start-chatgpt.ps1",
    "connector:assistant": "tsx src/cli.ts connector-assistant",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "diff:check": "git diff --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
