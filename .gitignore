# Release artifacts belong in GitHub Releases, not the Git tree.
*.app
*.dmg
*.pkg
*.exe
*.msi
*.zip
*.tar.gz

# Development-only tests, automation, packaging helpers, and measurements.
*.test.ts
/vitest.config.ts
/.github/workflows/*
!/.github/workflows/verify-windows.yml
/benchmarks/
/script/
/scripts/*
!/scripts/macos-dependency-doctor.sh
/linux/
/windows/Build-ChatGPTToCodexExe.ps1
/windows/ChatGPTToCodexSetup.cs
!/windows/README.md

# Only final runtime/readme assets belong in the public tree.
/assets/*
!/assets/chatgpt2codex-icon.png
!/assets/chatgpt2codex-icon.ico
!/assets/readme-hero.png

# Keep working notes and implementation reports local. Public documentation is
# an explicit allowlist so new reports cannot be staged accidentally.
/docs/*
!/docs/INSTALL.md
!/docs/BUILDING.md
!/docs/CONNECTION-DIAGNOSTICS.ko.md
!/docs/WINDOWS-QUICKSTART.ko.md

# Platform noise.
.DS_Store
Thumbs.db
Desktop.ini
