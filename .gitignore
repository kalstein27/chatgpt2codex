*.xip

# Development-only tests, automation, packaging helpers, and measurements.
*.test.ts
/vitest.config.ts
/.github/workflows/*
!/.github/workflows/verify-windows.yml
/benchmarks/
/script/
/scripts/*
!/scripts/apply-activity-dashboard.ts
!/scripts/macos-dependency-doctor.sh
!/scripts/check-publication-boundary.ts
/linux/
/windows/Build-ChatGPTToCodexExe.ps1
/windows/ChatGPTToCodexSetup.cs
!/windows/README.md

# Ad-hoc local review/patch material should never ride along with product commits.
*.patch
*.diff
*.rej
/tmp/
/private/

# Only final runtime/readme assets belong in the public tree.
/assets/*
!/assets/chatgpt2codex-icon.png
!/assets/chatgpt2codex-icon.ico
!/assets/readme-hero.png

# Documentation and working notes are local-only. Existing tracked files are
# still matched by these rules when publication guards use check-ignore --no-index.
/docs/

# Platform noise and machine-local IDE state.
DerivedData/
xcuserdata/
*.xcuserstate
.DS_Store
Thumbs.db
Desktop.ini