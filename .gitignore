# Local agent/editor state and private agent instructions.
.ai/
.agents/
.claude/
.codex/
.githooks/
.idea/
.vscode/
*.code-workspace
/AGENTS.md

# Dependencies, generated builds, and test output.
node_modules/
dist/
/build/
/release/
/installers/
/coverage/
/.nyc_output/
/test-results/
/playwright-report/
/screenshots/
/.cache/
/.npm/
*.lcov
*.xcresult
*.xcarchive
*.dSYM

# Local connector/runtime state and credentials.
.mcp.json
.env
.env.*
*.local
*.token
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
